    classDef control fill:#f5f3ff,stroke:#a78bfa,color:#0f172a;
    class FE,RN,II,FI,ROB,PRF,IX,FX,FA,WB,CT current;
    class LSU bline;
    class IM,DM external;
    class REC control;
