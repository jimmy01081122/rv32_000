[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 900

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/rv32_ooo_fp_execute.cmp_data.sv
read_rtlil ../../../../../partitions/rv32_ooo_fp_execute.cmp_data.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.rv32_ooo_fp_execute.cmp_data
setundef -anyseq gate.rv32_ooo_fp_execute.cmp_data
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

