[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 60

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/check.q.sv
read_rtlil ../../../../../partitions/check.q.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.check.q
setundef -anyseq gate.check.q
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

