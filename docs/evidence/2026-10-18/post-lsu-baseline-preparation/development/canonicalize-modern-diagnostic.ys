# Lower processes with the project's established explicit sequence, then assert
# that no process/latch remains before entering the standard optimized synth pass.
read_verilog build/baseline-setup/rtl_lowered.v
hierarchy -check -top rv32_ooo_core
proc_clean
proc_rmdead
proc_init
proc_arst
proc_mux
opt_expr
opt_clean
proc_dff
proc_memwr
proc_clean
opt_clean -purge
select -assert-none p:*
write_ilang build/baseline-setup/process-free.rtlil
check -assert
synth -top rv32_ooo_core -flatten -noabc
select -assert-none p:* t:$dlatch t:$_DLATCH_*
check -assert
stat
write_verilog -noattr build/baseline-setup/canonical.v
write_ilang build/baseline-setup/canonical.rtlil
