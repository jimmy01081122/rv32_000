# The project's generic synthesis process order, followed by a flat control-loop check.
read_verilog build/experiments/lsu-c-head-v1/lowering/C.v
hierarchy -check -top rv32_ooo_core
proc_clean
proc_rmdead
proc_init
proc_arst
proc_mux
opt_expr
opt_clean
proc_dff
proc_clean
opt_expr
opt_clean
check -assert
flatten
opt_clean
select -assert-none p:* t:$dlatch t:$_DLATCH_*
check -assert
scc -expect 0
